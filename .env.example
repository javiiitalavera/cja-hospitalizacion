# Copia este archivo como .env y rellena con los valores reales de tu
# proyecto de Supabase (Project Settings → API). El .env real NUNCA se
# sube al repositorio — está excluido en .gitignore a propósito.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon
